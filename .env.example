# ==============================================================================
# TicketGhar (तिकीटघर) Environment Variables Configuration
# Production & Local Setup Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & HOSTING
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for server-side Gemini AI features (if used).
# Automatically injected in AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this Next.js applet is hosted (e.g. https://ais-dev-... or http://localhost:3000)
APP_URL="http://localhost:3000"

# App Name & Default Branding
NEXT_PUBLIC_APP_NAME="TicketGhar (तिकीटघर)"
NEXT_PUBLIC_DEFAULT_CITY="Pune"

# ------------------------------------------------------------------------------
# 2. POSTGRESQL / GOOGLE CLOUD SQL DATABASE
# Note: In Google Cloud Run / AI Studio, Cloud SQL Auth Proxy automatically provides
# the Unix Domain Socket path at SQL_HOST.
# ------------------------------------------------------------------------------
# SQL_HOST: Unix socket directory (e.g. /cloudsql/prime-sylph-wthv3:asia-southeast1:ai-studio-05ee5a93) or "127.0.0.1" for local Postgres.
SQL_HOST="127.0.0.1"

# SQL_DB_NAME: PostgreSQL database name
SQL_DB_NAME="ai-studio-db"

# SQL_USER: App runtime user with read/write access (used by connection pool)
SQL_USER="postgres"

# SQL_PASSWORD: Password for SQL_USER
SQL_PASSWORD="your_postgres_password"

# SQL_ADMIN_USER: Admin user with DDL privileges for schema migrations (drizzle-kit)
SQL_ADMIN_USER="postgres"

# SQL_ADMIN_PASSWORD: Password for SQL_ADMIN_USER
SQL_ADMIN_PASSWORD="your_postgres_admin_password"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (RAZORPAY INDIA)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID: Public API key for Razorpay checkout integration
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# RAZORPAY_KEY_SECRET: Private API secret used on server-side to verify webhooks & signatures
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# PAYMENT_WEBHOOK_SECRET: Secret configured in Razorpay Webhooks dashboard
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. TICKET CRYPTOGRAPHY & GATE ENTRANCE SECURITY
# ------------------------------------------------------------------------------
# TICKET_SECRET: HMAC-SHA256 secret salt used to sign server-verifiable QR passes
TICKET_SECRET="your_secure_ticket_hmac_secret_salt_here"
