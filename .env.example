# ==============================================================================
# MahaTicket (महाटिकिट) — Production Environment Variables
# Copy to .env and configure real credentials. Never commit secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_URL="https://mahaticket.kalpkrutinfotech.com"
NEXT_PUBLIC_APP_URL="https://mahaticket.kalpkrutinfotech.com"
NEXT_PUBLIC_APP_NAME="MahaTicket"
NEXT_PUBLIC_DEFAULT_CITY="Pune"

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL / Supabase Transaction Pooler)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.your_project_ref:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
SQL_HOST="aws-0-ap-south-1.pooler.supabase.com"
SQL_PORT="6543"
SQL_SSL="true"
SQL_DB_NAME="postgres"
SQL_USER="postgres.your_project_ref"
SQL_PASSWORD="YOUR_DATABASE_PASSWORD"
SQL_ADMIN_USER="postgres.your_project_ref"
SQL_ADMIN_PASSWORD="YOUR_DATABASE_PASSWORD"

# ------------------------------------------------------------------------------
# RAZORPAY (Real Payment Gateway — Server & Client)
# ------------------------------------------------------------------------------
# Test mode keys start with rzp_test_*, Live mode keys start with rzp_live_*
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
PAYMENT_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# CRITICAL SECURITY SETTING:
# Must be "false" in production. When false, direct booking confirmation without 
# verified payment signature is strictly forbidden.
ALLOW_DIRECT_CONFIRM="false"
NEXT_PUBLIC_ALLOW_DIRECT_CONFIRM="false"

# ------------------------------------------------------------------------------
# SUPABASE (Client & Auth SDK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only service role key for administrative functions (never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# EMAIL (SMTP & Resend Delivery for Ticket PDFs)
# ------------------------------------------------------------------------------
# SMTP credentials (e.g., Resend SMTP, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@kalpkrutinfotech.com"
SMTP_PASS="re_your_smtp_key_here"
SMTP_FROM="MahaTicket <no-reply@kalpkrutinfotech.com>"
# Resend HTTP API Key fallback if SMTP fails
RESEND_API_KEY="re_your_resend_api_key_here"

# ------------------------------------------------------------------------------
# FIREBASE (Push Notifications & FCM Web Credentials - Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_PROJECT_ID=""
# Optional legacy server key for FCM HTTP integrations.
FCM_SERVER_KEY=""
# Preferred server auth for Admin SDK: set an absolute path to your service account JSON.
# Example (Windows): GOOGLE_APPLICATION_CREDENTIALS="C:\\secrets\\firebase-service-account.json"
# Example (Linux): GOOGLE_APPLICATION_CREDENTIALS="/opt/secrets/firebase-service-account.json"
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# ADMIN (Protected Admin Portal Authentication)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD="set_a_very_strong_random_admin_password_here"
ADMIN_SESSION_SECRET="set_a_64_character_random_hex_secret_here"

# ------------------------------------------------------------------------------
# SECURITY (HMAC Ticket Integrity & QR Tokens)
# ------------------------------------------------------------------------------
TICKET_SECRET="set_a_high_entropy_secret_for_ticket_hmac_signing_here"

# ------------------------------------------------------------------------------
# REDIS (Seat-hold fast cache — optional; falls back to in-memory TTL)
# ------------------------------------------------------------------------------
# REDIS_URL="redis://default:password@host:6379"
# UPSTASH_REDIS_URL="rediss://default:password@xxx.upstash.io:6379"
