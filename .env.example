# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL runtime connection (automatically provided in Cloud Run environment)
# SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME, SQL_ADMIN_USER, SQL_ADMIN_PASSWORD

# Security & Verification keys
TICKET_SECRET="your_secure_ticket_hmac_secret_salt_here"
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
