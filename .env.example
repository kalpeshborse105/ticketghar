# ==============================================================================
# MahaTicket (महाटिकिट) — Environment Variables
# Copy to .env and fill real values. Never commit secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MahaTicket"
NEXT_PUBLIC_DEFAULT_CITY="Pune"

# Admin panel password gate (/admin)
ADMIN_PASSWORD="change_me_strong_admin_password"
ADMIN_SESSION_SECRET="change_me_long_random_session_secret"

# ------------------------------------------------------------------------------
# SUPABASE POSTGRES (application database — only DB)
# ------------------------------------------------------------------------------
SQL_HOST="aws-0-ap-south-1.pooler.supabase.com"
SQL_PORT="6543"
SQL_SSL="true"
SQL_DB_NAME="postgres"
SQL_USER="postgres.your_project_reference"
SQL_PASSWORD="your_supabase_database_password"
SQL_ADMIN_USER="postgres.your_project_reference"
SQL_ADMIN_PASSWORD="your_supabase_database_password"

DATABASE_URL="postgresql://postgres.your_project_reference:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your_project_reference.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Server-only if needed for Storage/Admin APIs — never expose to browser/Android
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# ------------------------------------------------------------------------------
# TICKET SECURITY
# ------------------------------------------------------------------------------
TICKET_SECRET="your_secure_ticket_hmac_secret_salt_here"

# ------------------------------------------------------------------------------
# PAYMENTS — Razorpay Integration (REAL payment gateway)
# ------------------------------------------------------------------------------
# To enable REAL payments, obtain credentials from https://dashboard.razorpay.com/
# Test Mode: Use rzp_test_* keys for development/testing
# Live Mode: Use rzp_live_* keys for production only after full testing
#
# RAZORPAY_KEY_ID: Your Razorpay API Key ID (public, safe to expose to frontend)
# RAZORPAY_KEY_SECRET: Your Razorpay API Secret (NEVER expose to client/browser)
# PAYMENT_WEBHOOK_SECRET: Webhook secret from Razorpay dashboard for signature verification
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit real credentials to version control
# 2. RAZORPAY_KEY_SECRET must be kept secure on server only
# 3. Always verify payment signatures before confirming bookings
# 4. Test thoroughly in test mode before going live
#
# Example (Test Mode):
# RAZORPAY_KEY_ID="rzp_test_AbCdEfGhIjKlMnOp"
# RAZORPAY_KEY_SECRET="YourTestSecretKeyHere123456789"
# PAYMENT_WEBHOOK_SECRET="YourWebhookSecretFromDashboard"
#
# Until configured, system will return 503 for payment requests

# ALLOW_DIRECT_CONFIRM: Set to "true" ONLY for local QA/testing to bypass payment
# NEVER enable in production. Default: false (payment required)
# ALLOW_DIRECT_CONFIRM="false"

# NEXT_PUBLIC_ALLOW_DIRECT_CONFIRM: Client-side flag for admin direct confirm UI
# NEVER enable in production. Default: false
# NEXT_PUBLIC_ALLOW_DIRECT_CONFIRM="false"

# ------------------------------------------------------------------------------
# EMAIL (optional — do not claim email sent unless configured)
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_xxx"
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="re_xxx"
# EMAIL_FROM="MahaTicket <tickets@yourdomain.com>"

# ------------------------------------------------------------------------------
# FIREBASE / FCM (optional until push is live)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
