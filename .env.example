# ==============================================================================
# MahaTicket (महाटिकिट) Environment Variables Configuration
# Production & Local Setup Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & HOSTING
# ------------------------------------------------------------------------------
# APP_URL: Base URL where this Next.js app is hosted (e.g. https://mahaticket.kalpkrutinfotech.com)
APP_URL="https://mahaticket.kalpkrutinfotech.com"

# App Name & Default Branding
NEXT_PUBLIC_APP_NAME="MahaTicket (महाटिकिट)"
NEXT_PUBLIC_DEFAULT_CITY="Pune"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# SQL_HOST: Supabase Pooler Host (e.g. aws-0-ap-south-1.pooler.supabase.com) or direct host
SQL_HOST="aws-0-ap-south-1.pooler.supabase.com"

# SQL_DB_NAME: Default is "postgres"
SQL_DB_NAME="postgres"

# SQL_USER: Database username (e.g. postgres.[PROJECT-REF] when using pooler, or postgres)
SQL_USER="postgres.your_project_reference"

# SQL_PASSWORD: Your Supabase database password
SQL_PASSWORD="your_supabase_database_password"

# SQL_ADMIN_USER & SQL_ADMIN_PASSWORD: Used by drizzle-kit schema migrations
SQL_ADMIN_USER="postgres.your_project_reference"
SQL_ADMIN_PASSWORD="your_supabase_database_password"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (RAZORPAY INDIA)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID: Public API key for Razorpay checkout integration
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# RAZORPAY_KEY_SECRET: Private API secret used on server-side to verify webhooks & signatures
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# PAYMENT_WEBHOOK_SECRET: Secret configured in Razorpay Webhooks dashboard
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 4. TICKET CRYPTOGRAPHY & GATE ENTRANCE SECURITY
# ------------------------------------------------------------------------------
# TICKET_SECRET: HMAC-SHA256 secret salt used to sign server-verifiable QR passes
TICKET_SECRET="your_secure_ticket_hmac_secret_salt_here"

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY (OPTIONAL)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_USER="resend"
# SMTP_PASS="re_your_api_key"
